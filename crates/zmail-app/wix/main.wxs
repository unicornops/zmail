<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <!--
      Zmail MSI definition (WiX v3, built by cargo-wix on the Windows
      release job, and on pull requests by CI's Windows build, which
      installs and uninstalls it with scripts/check-windows-msi.ps1).
      Installs to Program Files, adds a Start-menu shortcut, and registers
      Zmail for mailto: links: the scheme's handler and a mail app in
      Settings > Apps > Default apps.
    -->
    <Product Id="*"
             Name="Zmail"
             Language="1033"
             Version="!(bind.fileVersion.zmail_app_exe)"
             Manufacturer="UnicornOps"
             UpgradeCode="7A8AFF84-FB5F-4920-8320-5DD02BCD7EFB">
        <Package InstallerVersion="200"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="Zmail desktop email client" />
        <MajorUpgrade DowngradeErrorMessage="A newer version of Zmail is already installed."
                      AllowSameVersionUpgrades="yes" />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="Main"
                 Title="Zmail"
                 Level="1"
                 Absent="disallow">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentGroupRef Id="StartMenuComponents" />
        </Feature>
    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="APPLICATIONFOLDER" Name="Zmail">
                    <Component Id="zmail_app.exe"
                               Guid="1E8E9408-EA69-4F6A-B7A8-7D489BF5AF53"
                               Win64="yes">
                        <File Id="zmail_app_exe"
                              Name="zmail-app.exe"
                              Source="$(var.CargoTargetDir)\release\zmail-app.exe"
                              KeyPath="yes" />
                    </Component>
                    <!-- The scheme itself, as Windows defines it: kept on
                         uninstall (Permanent), since other mail apps rely
                         on it. -->
                    <Component Id="mailto_scheme"
                               Guid="A43484A1-B31C-49CE-B1FB-FBE27FB88A15"
                               Permanent="yes"
                               Win64="yes">
                        <RegistryValue Root="HKLM"
                                       Key="SOFTWARE\Classes\mailto"
                                       Type="string"
                                       Value="URL:MailTo Protocol" />
                        <RegistryValue Root="HKLM"
                                       Key="SOFTWARE\Classes\mailto"
                                       Name="URL Protocol"
                                       Type="string"
                                       Value=""
                                       KeyPath="yes" />
                    </Component>
                    <!-- Zmail as a mail app (#457): the machine-wide mailto:
                         handler unless the user picks another, and listed
                         in Settings > Apps > Default apps (Default Programs:
                         Capabilities, URLAssociations and
                         RegisteredApplications), where the user's choice
                         wins. All of it goes on uninstall. -->
                    <Component Id="mailto_registration"
                               Guid="0530787E-0085-4F9B-9531-903310C64F1D"
                               Win64="yes">
                        <RegistryValue Root="HKLM"
                                       Key="SOFTWARE\Classes\mailto\DefaultIcon"
                                       Type="string"
                                       Value="[APPLICATIONFOLDER]zmail-app.exe,0" />
                        <RegistryValue Root="HKLM"
                                       Key="SOFTWARE\Classes\mailto\shell\open\command"
                                       Type="string"
                                       Value="&quot;[APPLICATIONFOLDER]zmail-app.exe&quot; &quot;%1&quot;" />
                        <!-- The ProgID Default apps sets for mailto: when the
                             user picks Zmail. -->
                        <RegistryKey Root="HKLM"
                                     Key="SOFTWARE\Classes\Zmail.Url.mailto"
                                     ForceDeleteOnUninstall="yes">
                            <RegistryValue Type="string" Value="Zmail email link" />
                            <RegistryValue Name="FriendlyTypeName"
                                           Type="string"
                                           Value="Zmail email link" />
                            <RegistryValue Key="DefaultIcon"
                                           Type="string"
                                           Value="[APPLICATIONFOLDER]zmail-app.exe,0" />
                            <RegistryValue Key="shell\open\command"
                                           Type="string"
                                           Value="&quot;[APPLICATIONFOLDER]zmail-app.exe&quot; &quot;%1&quot;" />
                        </RegistryKey>
                        <RegistryKey Root="HKLM"
                                     Key="SOFTWARE\Clients\Mail\Zmail"
                                     ForceDeleteOnUninstall="yes">
                            <RegistryValue Type="string" Value="Zmail" />
                            <RegistryValue Key="DefaultIcon"
                                           Type="string"
                                           Value="[APPLICATIONFOLDER]zmail-app.exe,0" />
                            <RegistryValue Key="shell\open\command"
                                           Type="string"
                                           Value="&quot;[APPLICATIONFOLDER]zmail-app.exe&quot;" />
                            <RegistryValue Key="Capabilities"
                                           Name="ApplicationName"
                                           Type="string"
                                           Value="Zmail" />
                            <RegistryValue Key="Capabilities"
                                           Name="ApplicationDescription"
                                           Type="string"
                                           Value="Fast, standards-compliant desktop email client" />
                            <RegistryValue Key="Capabilities"
                                           Name="ApplicationIcon"
                                           Type="string"
                                           Value="[APPLICATIONFOLDER]zmail-app.exe,0" />
                            <RegistryValue Key="Capabilities\URLAssociations"
                                           Name="mailto"
                                           Type="string"
                                           Value="Zmail.Url.mailto" />
                        </RegistryKey>
                        <RegistryValue Root="HKLM"
                                       Key="SOFTWARE\RegisteredApplications"
                                       Name="Zmail"
                                       Type="string"
                                       Value="SOFTWARE\Clients\Mail\Zmail\Capabilities"
                                       KeyPath="yes" />
                    </Component>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Zmail" />
            </Directory>
        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="APPLICATIONFOLDER">
            <ComponentRef Id="zmail_app.exe" />
            <ComponentRef Id="mailto_scheme" />
            <ComponentRef Id="mailto_registration" />
        </ComponentGroup>
        <ComponentGroup Id="StartMenuComponents" Directory="ApplicationProgramsFolder">
            <Component Id="start_menu_shortcut"
                       Guid="4792AC98-B099-4175-ACF2-739E500B649D">
                <Shortcut Id="ZmailStartMenuShortcut"
                          Name="Zmail"
                          Description="Zmail desktop email client"
                          Target="[APPLICATIONFOLDER]zmail-app.exe"
                          WorkingDirectory="APPLICATIONFOLDER">
                    <!-- The id the app sets for itself (APP_ID), so its
                         windows group with this shortcut on the taskbar
                         and its notifications are Zmail's. -->
                    <ShortcutProperty Key="System.AppUserModel.ID"
                                      Value="ie.unicornops.zmail" />
                </Shortcut>
                <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\Zmail"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
