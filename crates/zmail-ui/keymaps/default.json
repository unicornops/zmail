[
  {
    "bindings": {
      "secondary-q": "zmail::Quit"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "secondary-n": "zmail::NewMessage",
      "secondary-shift-a": "zmail::AddAccount",
      "secondary-1": "zmail::ShowMail",
      "secondary-2": "zmail::ShowDrafts",
      "secondary-3": "zmail::ShowOutbox",
      "secondary-shift-o": "zmail::RetryOutbox",
      "secondary-f": "zmail::FocusSearch",
      "secondary-alt-1": "zmail::SearchInFolder",
      "secondary-alt-2": "zmail::SearchInAccount",
      "secondary-alt-3": "zmail::SearchAllAccounts",
      "f5": "zmail::SyncAccount",
      "shift-f5": "zmail::SyncAll",
      "secondary-shift-n": "zmail::SyncAll",
      "secondary-shift-t": "zmail::ToggleTheme",
      "secondary-b": "zmail::ToggleSidebar",
      "secondary-[": "zmail::GoBack",
      "alt-left": "zmail::GoBack",
      "tab": "zmail::FocusNextPane",
      "shift-tab": "zmail::FocusPreviousPane",
      "f6": "zmail::FocusNextPane",
      "shift-f6": "zmail::FocusPreviousPane",
      "escape": "zmail::Cancel"
    }
  },
  {
    "context": "Sidebar",
    "bindings": {
      "down": "zmail::SelectNext",
      "up": "zmail::SelectPrevious",
      "home": "zmail::SelectFirst",
      "end": "zmail::SelectLast",
      "enter": "zmail::OpenSelected",
      "secondary-z": "zmail::Undo"
    }
  },
  {
    "context": "Reader && !TextInput",
    "bindings": {
      "n": "zmail::NextMessage",
      "p": "zmail::PreviousMessage",
      "enter": "zmail::ToggleMessage",
      "secondary-c": "text_input::Copy",
      "secondary-a": "text_input::SelectAll"
    }
  },
  {
    "context": "MessageList",
    "bindings": {
      "down": "zmail::SelectNext",
      "up": "zmail::SelectPrevious",
      "home": "zmail::SelectFirst",
      "end": "zmail::SelectLast",
      "enter": "zmail::OpenSelected",
      "shift-down": "zmail::ExtendSelectionDown",
      "shift-up": "zmail::ExtendSelectionUp",
      "secondary-a": "zmail::SelectAll",
      "secondary-z": "zmail::Undo"
    }
  },
  {
    "context": "Reader && !TextInput",
    "bindings": {
      "n": "zmail::NextMessage",
      "p": "zmail::PreviousMessage",
      "enter": "zmail::ToggleMessage",
      "secondary-c": "text_input::Copy",
      "secondary-a": "text_input::SelectAll"
    }
  },
  {
    "context": "MessageList || Reader",
    "bindings": {
      "secondary-r": "zmail::Reply",
      "secondary-shift-r": "zmail::ReplyAll",
      "secondary-shift-f": "zmail::Forward",
      "secondary-e": "zmail::Archive",
      "secondary-backspace": "zmail::Delete",
      "delete": "zmail::Delete",
      "backspace": "zmail::Delete",
      "secondary-shift-l": "zmail::ToggleFlag",
      "secondary-shift-u": "zmail::ToggleRead",
      "secondary-shift-s": "zmail::SaveAttachments"
    }
  },
  {
    "context": "Reader",
    "bindings": {
      "up": "zmail::ScrollUp",
      "down": "zmail::ScrollDown",
      "pageup": "zmail::PageUp",
      "pagedown": "zmail::PageDown",
      "secondary-z": "zmail::Undo"
    }
  },
  {
    "context": "Reader && !TextInput",
    "bindings": {
      "n": "zmail::NextMessage",
      "p": "zmail::PreviousMessage",
      "enter": "zmail::ToggleMessage",
      "secondary-c": "text_input::Copy",
      "secondary-a": "text_input::SelectAll"
    }
  },
  {
    "context": "Compose",
    "bindings": {
      "secondary-enter": "zmail::Send",
      "secondary-s": "zmail::SaveDraft",
      "secondary-shift-c": "zmail::ShowCc",
      "secondary-shift-b": "zmail::ShowBcc",
      "secondary-shift-a": "zmail::AddAttachment"
    }
  },
  {
    "context": "ComposeWindow",
    "bindings": {
      "escape": "zmail::Cancel"
    }
  },
  {
    "context": "RecipientField && showing_suggestions",
    "bindings": {
      "down": "zmail_components::SelectNext",
      "up": "zmail_components::SelectPrevious",
      "escape": "zmail_components::Cancel"
    }
  },
  {
    "context": "AccountSetup",
    "bindings": {
      "secondary-enter": "zmail::SaveAccount"
    }
  }
]
