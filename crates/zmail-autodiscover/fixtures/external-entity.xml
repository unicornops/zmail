<?xml version="1.0"?>
<!DOCTYPE clientConfig [
  <!ENTITY host SYSTEM "file:///etc/hostname">
]>
<clientConfig version="1.1">
  <emailProvider id="example.com">
    <incomingServer type="imap">
      <hostname>&host;</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
    </incomingServer>
  </emailProvider>
</clientConfig>
