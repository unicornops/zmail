+// apiOptions serves the API on a fixed port, and with a caller-supplied
+// certificate, when asked to. The built-in httptest certificate is a CA
+// certificate, which strict TLS clients refuse as a server certificate.
+func apiOptions(c *cli.Context) ([]server.Option, error) {
+	certFile, keyFile := c.String("tls-cert"), c.String("tls-key")
+	if (certFile == "") != (keyFile == "") {
+		return nil, fmt.Errorf("--tls-cert and --tls-key must be given together")
+	}
+
+	if c.Int("api-port") == 0 {
+		if certFile != "" {
+			return nil, fmt.Errorf("--tls-cert needs --api-port")
+		}
+
+		log.Printf("API on a random loopback port (gRPC GetInfo reports it)")
+
+		return []server.Option{server.WithTLS(c.Bool("tls"))}, nil
+	}
+
+	listener, err := net.Listen("tcp", fmt.Sprintf(":%d", c.Int("api-port")))
+	if err != nil {
+		return nil, err
+	}
+
+	if certFile == "" {
+		log.Printf("API on :%d (tls=%t, built-in test certificate)", c.Int("api-port"), c.Bool("tls"))
+
+		return []server.Option{server.WithListener(listener), server.WithTLS(c.Bool("tls"))}, nil
+	}
+
+	cert, err := tls.LoadX509KeyPair(certFile, keyFile)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load the API certificate: %w", err)
+	}
+
+	listener = tls.NewListener(listener, &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		MinVersion:   tls.VersionTLS12,
+	})
+
+	log.Printf("API on :%d (TLS with %s)", c.Int("api-port"), certFile)
+
+	// The listener terminates TLS, so the test server itself runs plain.
+	return []server.Option{server.WithListener(listener), server.WithTLS(false)}, nil
+}
